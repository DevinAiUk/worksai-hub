# WorksAI Dots (it.worksai.org) — Required Server-Side Secrets Template (.env.example)
# Provision via `wrangler secret put <KEY>` or Cloudflare Worker secret bindings.
# NEVER commit live secret values to Git or bundle them in client assets.
WORKSAI_ENV=production
JWT_SECRET=<replace-with-32-plus-byte-cryptographic-secret>
BETTER_AUTH_SECRET=<replace-with-32-plus-byte-cryptographic-secret>
ARTIFACT_HMAC_SECRET=<replace-with-32-plus-byte-cryptographic-secret>
APPROVAL_SIGNING_SECRET=<replace-with-32-plus-byte-cryptographic-secret>
DEMO_SIGNING_SECRET=<replace-with-distinct-32-plus-byte-demo-sandbox-secret>
