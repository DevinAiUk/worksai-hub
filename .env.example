# Neon Serverless Postgres connection string (uses isolated schema worksai_hub)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth secret (generate via: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-strong-32-byte-secret"
BETTER_AUTH_URL="https://worksai.org"

# Optional Cloudflare R2 Bucket Name for Data Lake raw object payloads
R2_DATALAKE_BUCKET="worksai-datalake"
